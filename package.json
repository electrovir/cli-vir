{
    "name": "cli-vir",
    "version": "1.1.2",
    "description": "Parse CLI args with type safety.",
    "keywords": [
        "cli",
        "args",
        "parser",
        "type-safe"
    ],
    "homepage": "https://github.com/electrovir/cli-vir",
    "bugs": {
        "url": "https://github.com/electrovir/cli-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/cli-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "virmator test node",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.7.0",
        "@augment-vir/common": "^32.7.0"
    },
    "devDependencies": {
        "@augment-vir/node": "^32.7.0",
        "@augment-vir/test": "^32.7.0",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "c8": "^12.0.0",
        "cspell": "^10.4.0",
        "dependency-cruiser": "^18.7.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.4.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^79.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.1.1",
        "npm-check-updates": "^23.1.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^4.1.0",
        "runstorm": "^1.1.0",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "virmator": "^14.38.0"
    },
    "engines": {
        "node": ">=22"
    }
}
